{
  "name": "@vulsecms/core",
  "version": "0.1.0-beta.1",
  "description": "Astro-native headless CMS for Cloudflare (D1, R2, Workers)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulsecms/vulse.git",
    "directory": "packages/vulse"
  },
  "bugs": "https://github.com/vulsecms/vulse/issues",
  "homepage": "https://github.com/vulsecms/vulse#readme",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "astro-loader",
    "cms",
    "cloudflare",
    "headless-cms",
    "d1",
    "workers"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "vulse": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    },
    "./integration/cron": {
      "types": "./dist/integration/cron.d.ts",
      "import": "./dist/integration/cron.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client/auth": {
      "import": "./src/client/auth.ts"
    },
    "./client/components/SignInForm.astro": "./src/client/components/SignInForm.astro",
    "./client/components/SignUpForm.astro": "./src/client/components/SignUpForm.astro",
    "./client/components/ForgotPasswordForm.astro": "./src/client/components/ForgotPasswordForm.astro",
    "./client/components/ResetPasswordForm.astro": "./src/client/components/ResetPasswordForm.astro",
    "./client/components/SignOutButton.astro": "./src/client/components/SignOutButton.astro",
    "./client/components/SessionGuard.astro": "./src/client/components/SessionGuard.astro",
    "./client/BlockRenderer.vue": "./src/client/BlockRenderer.vue",
    "./client/BlockRenderer.astro": "./src/client/BlockRenderer.astro",
    "./client/components/FormRenderer.astro": "./src/client/components/FormRenderer.astro",
    "./admin.css": "./src/admin/styles/admin.css"
  },
  "files": [
    "dist",
    "migrations",
    "src/admin",
    "src/core",
    "src/server",
    "src/scaffold",
    "src/package-name.ts",
    "src/client",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "pnpm run build:bridge && node scripts/sync-version.mjs && tsc -p tsconfig.json",
    "build:bridge": "esbuild src/client/live-preview-bridge.ts --bundle --format=esm --outfile=src/server/assets/live-preview-bridge.js --platform=browser && node scripts/embed-bridge.mjs",
    "pretest": "node scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "node scripts/sync-version.mjs",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "drizzle:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@astrojs/vue": "^6.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tiptap/core": "^2.8.0",
    "@tiptap/pm": "^2.8.0",
    "@tiptap/starter-kit": "^2.8.0",
    "@tiptap/vue-3": "^2.8.0",
    "better-auth": "^1.0.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.3",
    "morphdom": "^2.7.8",
    "nanoid": "^5.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.6.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20240320.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "astro": "^6.3.7",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "vite": "^7.3.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.94.0"
  },
  "peerDependencies": {
    "@astrojs/vue": "^6.0.0",
    "astro": "^6.3.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/vue": {
      "optional": false
    },
    "vue": {
      "optional": false
    }
  }
}
