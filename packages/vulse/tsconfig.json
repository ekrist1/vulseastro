{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "types": ["@cloudflare/workers-types", "vitest/globals", "node"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "dist",
    "tests",
    "src/admin/**/*.vue",
    "src/admin/components/fields/**/*.ts",
    "src/admin/composables/**",
    "src/client/**"
  ]
}
