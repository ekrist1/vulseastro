---
interface Props { redirectTo?: string; class?: string }
const { redirectTo = '/reset-password', class: cls } = Astro.props
---
<form data-vulse-forgot-password data-redirect={redirectTo} class={cls} novalidate>
  <p data-vulse-auth-error class="vulse-auth-error" hidden role="alert"></p>
  <p data-vulse-auth-success class="vulse-auth-success" hidden role="status"></p>
  <slot />
</form>
<script>
  document.querySelectorAll('form[data-vulse-forgot-password]').forEach((form) => {
    const errorEl = form.querySelector('[data-vulse-auth-error]') as HTMLElement | null
    const successEl = form.querySelector('[data-vulse-auth-success]') as HTMLElement | null
    const showError = (message: string) => {
      if (errorEl) {
        errorEl.textContent = message
        errorEl.hidden = false
      }
      if (successEl) successEl.hidden = true
    }
    const showSuccess = (message: string) => {
      if (successEl) {
        successEl.textContent = message
        successEl.hidden = false
      }
      if (errorEl) errorEl.hidden = true
    }
    const clearMessages = () => {
      if (errorEl) {
        errorEl.textContent = ''
        errorEl.hidden = true
      }
      if (successEl) {
        successEl.textContent = ''
        successEl.hidden = true
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      clearMessages()
      const f = new FormData(form as HTMLFormElement)
      const email = f.get('email')
      if (typeof email !== 'string' || !email) {
        showError('Enter your email address.')
        return
      }
      const redirectTo = (form as HTMLFormElement).dataset.redirect || '/reset-password'
      const res = await fetch('/api/auth/request-password-reset', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ email, redirectTo }),
        credentials: 'same-origin',
      })
      const body = await res.json().catch(() => null)
      const event = new CustomEvent(res.ok ? 'vulse:forgot-password:success' : 'vulse:forgot-password:error', {
        detail: { status: res.status, body },
      })
      form.dispatchEvent(event)
      if (res.ok) {
        showSuccess('If an account exists for that email, a reset link has been sent.')
        return
      }
      const msg =
        body && typeof body === 'object' && 'message' in body && typeof (body as { message: unknown }).message === 'string'
          ? (body as { message: string }).message
          : 'Could not send reset email. Try again later.'
      showError(msg)
    })
  })
</script>
