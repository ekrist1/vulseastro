---
interface Props { redirectTo?: string; class?: string }
const { redirectTo = '/sign-in', class: cls } = Astro.props
---
<form data-vulse-reset-password data-redirect={redirectTo} class={cls} novalidate>
  <p data-vulse-auth-error class="vulse-auth-error" hidden role="alert"></p>
  <slot />
</form>
<script>
  function tokenFromUrl(): string | null {
    const params = new URLSearchParams(window.location.search)
    return params.get('token') || params.get('error')
  }

  document.querySelectorAll('form[data-vulse-reset-password]').forEach((form) => {
    const errorEl = form.querySelector('[data-vulse-auth-error]') as HTMLElement | null
    const tokenInput = form.querySelector('[data-vulse-reset-token]') as HTMLInputElement | null
    const showError = (message: string) => {
      if (!errorEl) return
      errorEl.textContent = message
      errorEl.hidden = false
    }
    const clearError = () => {
      if (!errorEl) return
      errorEl.textContent = ''
      errorEl.hidden = true
    }

    const urlToken = tokenFromUrl()
    if (urlToken === 'INVALID_TOKEN') {
      showError('This reset link is invalid or has expired. Request a new one.')
    } else if (urlToken && tokenInput) {
      tokenInput.value = urlToken
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      clearError()
      const f = new FormData(form as HTMLFormElement)
      const token = (f.get('token') as string | null) ?? urlToken
      const password = f.get('password')
      if (!token || typeof token !== 'string') {
        showError('Missing reset token. Use the link from your email.')
        return
      }
      if (typeof password !== 'string' || password.length < 8) {
        showError('Password must be at least 8 characters.')
        return
      }
      const res = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ token, newPassword: password }),
        credentials: 'same-origin',
      })
      const body = await res.json().catch(() => null)
      const event = new CustomEvent(res.ok ? 'vulse:reset-password:success' : 'vulse:reset-password:error', {
        detail: { status: res.status, body },
      })
      form.dispatchEvent(event)
      if (res.ok) {
        window.location.href = (form as HTMLFormElement).dataset.redirect || '/sign-in'
        return
      }
      const msg =
        body && typeof body === 'object' && 'message' in body && typeof (body as { message: unknown }).message === 'string'
          ? (body as { message: string }).message
          : 'Could not reset password. The link may have expired.'
      showError(msg)
    })
  })
</script>
