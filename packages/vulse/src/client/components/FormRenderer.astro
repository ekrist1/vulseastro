---
interface Props {
  form: string
  class?: string
  action?: string
}
const { form, class: cls, action = `/api/vulse/forms/${form}/submit` } = Astro.props
---
<form data-vulse-form={form} data-action={action} class={cls} novalidate>
  <slot />
</form>
<script>
  document.querySelectorAll('form[data-vulse-form]').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault()
      const form = formEl as HTMLFormElement
      const fd = new FormData(form)
      const payload: Record<string, unknown> = {}
      for (const [k, v] of fd.entries()) {
        if (payload[k] !== undefined) continue
        payload[k] = v instanceof File ? v.name : v
      }
      for (const el of form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')) {
        payload[el.name] = el.checked
      }
      const action = form.dataset.action ?? form.action
      const res = await fetch(action, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'same-origin',
      })
      const body = await res.json().catch(() => ({})) as { ok?: boolean; data?: { ok?: boolean; redirect?: string; message?: string } }
      const data = body.data ?? body
      const eventName = res.ok && data.ok !== false ? 'vulse:form:success' : 'vulse:form:error'
      form.dispatchEvent(new CustomEvent(eventName, { detail: { status: res.status, data } }))
      if (res.ok && data.redirect) window.location.href = data.redirect
    })
  })
</script>
