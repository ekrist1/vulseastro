---
import SessionGuard from '@ekrist1/vulse/client/components/SessionGuard.astro'
import BlockRenderer from '@ekrist1/vulse/client/BlockRenderer.astro'
import SiteLayout from '../../layouts/SiteLayout.astro'
import { getRuntimeEnv, getRuntime, createDb, registryForRequest } from '@ekrist1/vulse/server'

const slug = Astro.params.slug!
const env = getRuntimeEnv()
const db = createDb(env.DB)
const rt = await getRuntime(env, await registryForRequest(db), Astro.url.origin)
const session = await rt.auth.api.getSession({ headers: Astro.request.headers })
if (!session) return Astro.redirect(`/sign-in?next=/recipes/${slug}`)

const recipe = await rt.sdk.collections.findBySlug('recipe', slug, { audience: session.user })
if (!recipe) return new Response(null, { status: 404, statusText: 'Not found' })

const content = recipe.content as { title: string; body?: unknown }
---
<SiteLayout title={`${content.title} · Recipe`}>
  <SessionGuard requireRole="member" redirectTo={`/sign-in?next=/recipes/${slug}`}>
    <article class="prose-content">
      <p class="hero__eyebrow" style="margin-bottom: 0.5rem;">Members only</p>
      <h1>{content.title}</h1>
      <BlockRenderer blocks={content.body ?? []} mediaUrl={(id) => `/api/vulse/media/${id}/file`} />
    </article>
  </SessionGuard>
</SiteLayout>
