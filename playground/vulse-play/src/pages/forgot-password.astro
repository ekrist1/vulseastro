---
import SiteLayout from '../layouts/SiteLayout.astro'
import ForgotPasswordForm from '@ekrist1/vulse/client/components/ForgotPasswordForm.astro'

const next = Astro.url.searchParams.get('next') ?? '/sign-in'
---
<SiteLayout title="Forgot password · Vulse Playground" description="Request a password reset link.">
  <div class="auth-page">
    <div class="auth-card">
      <p class="hero__eyebrow">Account</p>
      <h1 class="auth-card__title">Forgot password</h1>
      <p class="auth-card__lead">Enter your email and we will send you a link to reset your password.</p>

      <ForgotPasswordForm redirectTo="/reset-password" class="auth-form">
        <label class="auth-field">
          <span class="auth-label">Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <button type="submit" class="btn btn--primary auth-submit">Send reset link</button>
      </ForgotPasswordForm>

      <p class="auth-card__footer">
        Remember your password?
        <a href={`/sign-in?next=${encodeURIComponent(next)}`}>Sign in</a>
      </p>
    </div>
  </div>
</SiteLayout>

<style>
  .vulse-auth-success {
    margin: 0 0 1rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    background: rgba(56, 180, 120, 0.12);
    color: #7dcea0;
    font-size: 0.875rem;
  }
</style>
