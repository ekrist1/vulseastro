---
import SiteLayout from '../layouts/SiteLayout.astro'
import BlockRenderer from '@ekrist1/vulse/client/BlockRenderer.astro'
import { getRuntimeEnv, getRuntime, createDb, registryForRequest, resolvePreviewContent } from '@ekrist1/vulse/server'

const slug = Astro.params.slug!
const env = getRuntimeEnv()
const db = createDb(env.DB)
const rt = await getRuntime(env, await registryForRequest(db), Astro.url.origin)
const session = await rt.auth.api.getSession({ headers: Astro.request.headers })

const page = await rt.sdk.collections.findBySlug('page', slug, {
  ...(session?.user ? { audience: session.user } : {}),
})
if (!page) return new Response(null, { status: 404, statusText: 'Not found' })

const content = resolvePreviewContent(page, Astro.locals) as {
  title: string
  body?: unknown
}
---
<SiteLayout title={`${content.title} · Vulse Playground`}>
  <article class="prose-content">
    <p class="hero__eyebrow" style="margin-bottom: 0.5rem;">Page</p>
    <h1>{content.title}</h1>
    <BlockRenderer blocks={content.body ?? []} mediaUrl={(id) => `/api/vulse/media/${id}/file`} />
  </article>
</SiteLayout>
