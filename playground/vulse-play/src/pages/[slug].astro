---
import { getCollection } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import BlockRenderer from 'vulse/client/BlockRenderer.astro'

const { slug } = Astro.params
const pages = await getCollection('page')
const page = pages.find((p) => p.data.slug === slug)
if (!page) return new Response(null, { status: 404, statusText: 'Not found' })
---
<SiteLayout title={`${page.data.title} · Vulse Playground`}>
  <article class="prose-content">
    <p class="hero__eyebrow" style="margin-bottom: 0.5rem;">Page</p>
    <h1>{page.data.title}</h1>
    <BlockRenderer blocks={page.data.body ?? []} mediaUrl={(id) => `/api/vulse/media/${id}/file`} />
  </article>
</SiteLayout>
