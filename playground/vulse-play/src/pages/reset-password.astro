---
import SiteLayout from '../layouts/SiteLayout.astro'
import ResetPasswordForm from '@ekrist1/vulse/client/components/ResetPasswordForm.astro'

const next = Astro.url.searchParams.get('next') ?? '/sign-in'
---
<SiteLayout title="Reset password · Vulse Playground" description="Choose a new password.">
  <div class="auth-page">
    <div class="auth-card">
      <p class="hero__eyebrow">Account</p>
      <h1 class="auth-card__title">Reset password</h1>
      <p class="auth-card__lead">Enter a new password for your account.</p>

      <ResetPasswordForm redirectTo={next} class="auth-form">
        <input type="hidden" name="token" data-vulse-reset-token value="" />
        <label class="auth-field">
          <span class="auth-label">New password</span>
          <input name="password" type="password" required autocomplete="new-password" minlength="8" />
        </label>
        <button type="submit" class="btn btn--primary auth-submit">Update password</button>
      </ResetPasswordForm>

      <p class="auth-card__footer">
        <a href={`/forgot-password?next=${encodeURIComponent(next)}`}>Request a new reset link</a>
      </p>
    </div>
  </div>
</SiteLayout>
