---
import SiteLayout from '../layouts/SiteLayout.astro'
import SignInForm from '@vulsecms/core/client/components/SignInForm.astro'

const next = Astro.url.searchParams.get('next') ?? '/'
---
<SiteLayout title="Sign in · Vulse Playground" description="Sign in to access member-only content.">
  <div class="auth-page">
    <div class="auth-card">
      <p class="hero__eyebrow">Account</p>
      <h1 class="auth-card__title">Sign in</h1>
      <p class="auth-card__lead">Access member-only recipes and other gated content.</p>

      <SignInForm redirectTo={next} class="auth-form">
        <label class="auth-field">
          <span class="auth-label">Email</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
        <label class="auth-field">
          <span class="auth-label">Password</span>
          <input name="password" type="password" required autocomplete="current-password" />
        </label>
        <button type="submit" class="btn btn--primary auth-submit">Sign in</button>
      </SignInForm>

      <p class="auth-card__footer auth-card__footer--split">
        <a href={`/forgot-password?next=${encodeURIComponent(next)}`}>Forgot password?</a>
        <span>
          No account yet?
          <a href={`/sign-up?next=${encodeURIComponent(next)}`}>Create one</a>
        </span>
      </p>
    </div>
  </div>
</SiteLayout>
