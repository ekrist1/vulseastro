---
import '../styles/site.css'
import SignOutButton from '@ekrist1/vulse/client/components/SignOutButton.astro'
import { getRuntimeEnv, createDb, getRuntime, registryForRequest } from '@ekrist1/vulse/server'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  activeNav?: 'home' | 'examples' | 'admin'
}

const { title = 'Vulse Playground', description = 'Demo site for the Vulse Astro CMS', ogImage, activeNav } = Astro.props
const pathname = Astro.url.pathname

type SessionUser = {
  email: string
  name?: string | null
  displayName?: string | null
  role?: string | null
}

let sessionUser: SessionUser | null = null

try {
  const env = getRuntimeEnv()
  const db = createDb(env.DB)
  const rt = await getRuntime(env, await registryForRequest(db), Astro.url.origin)
  const session = await rt.auth.api.getSession({ headers: Astro.request.headers })
  sessionUser = (session?.user as SessionUser | undefined) ?? null
} catch {
  // Runtime unavailable outside Cloudflare (e.g. static analysis)
}

const userLabel =
  sessionUser?.displayName?.trim() ||
  sessionUser?.name?.trim() ||
  sessionUser?.email ||
  null
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {ogImage && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a href="/" class="site-logo">Vulse <span>Play</span></a>
        <nav class="site-nav" aria-label="Main">
          <a href="/" class:list={{ 'is-active': activeNav === 'home' || pathname === '/' }}>Home</a>
          <a href="/examples/accordion" class:list={{ 'is-active': activeNav === 'examples' || pathname.startsWith('/examples') }}>Examples</a>
          {!sessionUser && (
            <>
              <a href="/sign-in" class:list={{ 'is-active': pathname === '/sign-in' }}>Sign in</a>
              <a href="/sign-up" class:list={{ 'is-active': pathname === '/sign-up' }}>Sign up</a>
            </>
          )}
          <a href="/admin" class:list={{ 'is-active': activeNav === 'admin' }}>Admin</a>
        </nav>
        {sessionUser && (
          <div class="site-session">
            <div class="site-session__meta">
              <span class="site-session__name">{userLabel}</span>
              {sessionUser.role && (
                <span class="site-session__role">{sessionUser.role}</span>
              )}
            </div>
            <SignOutButton redirectTo="/" class="btn btn--ghost site-session__sign-out">
              Sign out
            </SignOutButton>
          </div>
        )}
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>Vulse playground — Astro + Cloudflare D1</span>
        <a href="https://github.com/ekrist1/vulseastro">View source</a>
      </div>
    </footer>
  </body>
</html>
